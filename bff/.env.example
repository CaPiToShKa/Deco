# Copy to bff/.env (never commit it) or set these in your hosting platform's secret store.
PORT=8080

# mock = record calls in memory (GET /debug/sfmc-calls); live = call the real SFMC REST API
SFMC_MODE=mock

# Installed Package (API Integration, Server-to-Server) — Setup > Apps > Installed Packages
SFMC_SUBDOMAIN=
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=
# MID of the business unit (optional)
SFMC_ACCOUNT_ID=

# External keys of the Data Extensions (create them as described in docs/KONFIGURACJA_SFMC.md)
SFMC_DE_PROFILE=DECO_App_Profile
SFMC_DE_CONSENTS=DECO_App_Consents
SFMC_DE_ADDONS=DECO_App_AddOns
SFMC_DE_COUPONS=DECO_App_Coupons

# Journey Builder API Event definition keys (leave blank to skip events)
SFMC_EVENT_CONSENT_CHANGED=
SFMC_EVENT_ADDON_CHANGED=
SFMC_EVENT_DELETION_REQUESTED=

# Optional: JSON array of articles or an RSS feed; blank = sample articles
NEWS_FEED_URL=
APP_TOKEN_TTL_SECONDS=3600
